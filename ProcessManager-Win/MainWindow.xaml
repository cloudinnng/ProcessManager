<Window
    x:Class="ProcessManager.Win.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:ProcessManager.Win.Services"
    xmlns:controls="using:ProcessManager.Win.Controls"
    Title="进程管理器">
    <Grid x:Name="Root" Padding="24" RowSpacing="16" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <controls:SearchHighlightState x:Key="SearchHighlightState" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="进程" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="打开项目目录" Click="OpenProject_Click" />
            <Button Grid.Column="2" Content="启动程序" Click="Start_Click" />
            <Button x:Name="EndButton" Grid.Column="3" Content="结束进程" IsEnabled="False" Click="End_Click" ToolTipService.ToolTip="强制结束选中的进程（Alt+E）">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Menu" Key="E" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索名称、PID、路径或命令行（空格分隔关键词，回车存为常用）" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" AutomationProperties.Name="搜索进程名称、PID、路径或命令行" />
                <ToggleSwitch x:Name="AutoRefresh" Grid.Column="1" IsOn="True" OnContent="自动刷新（2 秒）" OffContent="已暂停自动刷新" VerticalAlignment="Center" AutomationProperties.Name="自动刷新" />
                <Button x:Name="AddQuickSearchButton" Grid.Column="2" Content="添加常用" IsEnabled="False" Click="AddQuickSearch_Click" ToolTipService.ToolTip="把当前搜索词保存为常用搜索标签" AutomationProperties.Name="添加常用搜索" />
                <Button x:Name="RefreshButton" Grid.Column="3" Content="刷新" Click="Refresh_Click" />
            </Grid>
            <ScrollViewer x:Name="QuickSearchBar" Visibility="Collapsed" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="QuickSearchList" AutomationProperties.Name="常用搜索标签">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="QuickSearch_Click" Background="Transparent" BorderThickness="0" Padding="10,4,4,4" ToolTipService.ToolTip="{Binding}">
                                        <TextBlock Text="{Binding}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                    </Button>
                                    <Button Click="RemoveQuickSearch_Click" Background="Transparent" BorderThickness="0" Padding="4,4,8,4" ToolTipService.ToolTip="删除该常用搜索" AutomationProperties.Name="删除该常用搜索">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </StackPanel>
        <InfoBar x:Name="MessageBar" Grid.Row="2" IsOpen="False" Severity="Error" />
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="12,0,28,0" ColumnSpacing="16">
                <Grid.Resources>
                    <Style x:Key="SortHeaderStyle" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0,6" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="160" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="NameSortButton" Content="进程名称 ↑" Tag="Name" Style="{StaticResource SortHeaderStyle}" Click="SortHeader_Click" />
                <Button x:Name="IdSortButton" Grid.Column="1" Content="PID" Tag="Id" Style="{StaticResource SortHeaderStyle}" Click="SortHeader_Click" />
                <Button x:Name="CpuSortButton" Grid.Column="2" Content="CPU" Tag="Cpu" Style="{StaticResource SortHeaderStyle}" Click="SortHeader_Click" />
                <Button x:Name="MemorySortButton" Grid.Column="3" Content="内存" Tag="Memory" Style="{StaticResource SortHeaderStyle}" Click="SortHeader_Click" />
                <TextBlock Grid.Column="4" Text="可执行文件路径" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
            <ListView x:Name="ProcessList" Grid.Row="1" SelectionMode="Extended" SelectionChanged="Process_SelectionChanged" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="进程列表">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="services:ProcessSnapshot">
                        <Grid Padding="0,7" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="160" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:ProcessIcon FilePath="{x:Bind FilePath, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" controls:SearchHighlight.Query="{Binding Query, Source={StaticResource SearchHighlightState}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <ToolTipService.ToolTip>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" controls:SearchHighlight.Query="{Binding Query, Source={StaticResource SearchHighlightState}}" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind Id}" controls:SearchHighlight.Query="{Binding Query, Source={StaticResource SearchHighlightState}}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind CpuText, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind MemoryText, Mode=OneWay}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind PathText, Mode=OneWay}" controls:SearchHighlight.Query="{Binding Query, Source={StaticResource SearchHighlightState}}" TextTrimming="CharacterEllipsis">
                                <ToolTipService.ToolTip>
                                    <StackPanel MaxWidth="720" Spacing="4">
                                        <TextBlock Text="可执行文件路径" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind PathText, Mode=OneWay}" controls:SearchHighlight.Query="{Binding Query, Source={StaticResource SearchHighlightState}}" TextWrapping="Wrap" />
                                        <TextBlock Text="命令行" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind CommandLine, Mode=OneWay}" controls:SearchHighlight.Query="{Binding Query, Source={StaticResource SearchHighlightState}}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ToolTipService.ToolTip>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="正在加载进程…" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="1" Text="— 表示数据不可用或正在采样" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
